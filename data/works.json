  {
    "id": "monthly-grandmothers",
    "type": "project",
    "category": { "ko": "창작 프로그램", "en": "Creative Programme" },
    "title": { "ko": "월간 할머니들", "en": "Monthly Grandmothers" },
    "subtitle": { "ko": "8월~12월 5명의 작가들의 릴레이 낭독", "en": "" },
    "artist": { "ko": "극단 호랑이기운", "en": "Tiger Energy Theatre Company" },
    "artists": [],
    "producers": ["miseon", "jisun"],
    "year": "2026",
    "yearFrom": 2026,
    "status": "ongoing",
    "lead": { "ko": "우리는 무사히 할머니가 될 수 있을까.", "en": "" },
    "body": {
      "ko": "〈월간 할머니들〉은 여성 노년을 다룬 신작 희곡 다섯 편을 쓰기 위한 릴레이 낭독입니다. 2026년 8월부터 12월까지 매달 한 번, 둥지230에서 작가가 자신의 초고 일부를 읽고 관객과 이야기를 나눕니다.\n\n시작은 한 편의 공연이 남긴 돈이었습니다. 이오진 작가는 2025년 〈히스테리 앵자이어티 춤추는 할머니〉를 올린 뒤 남은 티켓 수익으로 할머니 이야기를 이어가려 했고, 무대에 올릴 만한 희곡을 찾아 나섰습니다. 그리스 비극에서는 당위를 찾지 못했고, 한국 근현대 희곡에는 어머니와 딸, 며느리와 술집 작부가 많았으며, 동시대 희곡은 손에 꼽혔습니다. 없으면 써야 했고, 혼자서는 안 될 일이었습니다.\n\n그렇게 30대 여성 극작가 다섯 명이 모였습니다. 이오진, 안정민, 나수민, 김연재, 신효진. 도트는 이들이 쓸 판을 만듭니다.\n\n노년에 대한 두려움도 낭만화도 덜어내고, 나의 노년을 생각해보는 자리입니다. 할머니는 되는 것이 아니라, 할머니라는 상태에 진입하게 되는 것인지도 모릅니다.\n\n다듬어지지 않은 초고를 그대로 만나는 초독회입니다.",
      "en": ""
    },
    "venue": { "ko": "둥지230", "en": "Doongji 230" },
    "produced": { "ko": "극단 호랑이기운 × 프로듀서그룹 도트", "en": "Tiger Energy Theatre Company × Producer Group DOT" },
    "commission": { "ko": "", "en": "" },
    "keywords": { "ko": "여성 노년, 신작 희곡, 낭독", "en": "" },
    "note": { "ko": "초안 — 확인 필요", "en": "" },
    "cover": "img/works/monthly-grandmothers/01.jpg",
    "homeFeature": []
  }
]
